# Copy values into a local, untracked .env file before starting the Express server.
HOST=127.0.0.1
PORT=3001
LAN_DEMO=0

# Server-only local PostgreSQL. Synthetic development credentials; never use for deployment.
# Matches npm run db:up. Never prefix these settings with VITE_.
DATABASE_URL=postgresql://sigap_dev:sigap_local_synthetic_only@127.0.0.1:54329/sigap_staging
DATABASE_POOL_MAX=10
SESSION_SECRET=

# LAN demo only: set LAN_DEMO=1, HOST=0.0.0.0, and both readable TLS paths.
# Keep private keys in this local, ignored project folder; never share them.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Public build-time map settings. Keep 0,0 until a demo area is selected.
VITE_DEMO_MAP_CENTER_LAT=0
VITE_DEMO_MAP_CENTER_LNG=0
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
