# Copy this template to frontend/.env and replace placeholders locally.
# Start the MySQL service in XAMPP (MariaDB). Create database sigap first.
HOST=127.0.0.1
PORT=3001
LAN_DEMO=0
DATABASE_URL=mysql://sigap_user:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:3306/sigap
DATABASE_POOL_MAX=10
# Generate locally: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
TLS_CERT_PATH=
TLS_KEY_PATH=
VITE_DEMO_MAP_CENTER_LAT=0
VITE_DEMO_MAP_CENTER_LNG=0
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
