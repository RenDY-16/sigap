import assert from 'node:assert/strict';
import { createServer } from 'node:http';
import { randomBytes } from 'node:crypto';
import pg from 'pg';
import { createApplication } from '../src/server/app.ts';
import { runMigrations } from '../src/server/db/migrate.ts';
import { bootstrapFirstAdmin } from '../src/server/identity/staff-repository.ts';
import { createOutboxPublisher } from '../src/server/services/outbox-publisher.ts';
const url=new URL(process.env.SIGAP_VERIFY_DATABASE_URL??'postgresql://sigap_dev:sigap_local_synthetic_only@127.0.0.1:54329/sigap_staging');
const admin=new pg.Pool({connectionString:url.toString()});const name=`sigap_outbox_${Date.now()}_${randomBytes(4).toString('hex')}`;
let created=false;let pool:pg.Pool|undefined;let server:ReturnType<typeof createServer>|undefined;let base='';
const secret=randomBytes(32).toString('hex');const password=randomBytes(24).toString('hex');const checks:string[]=[];
const config={databaseUrl:'unused',databasePoolMax:1,host:'127.0.0.1',port:0,sessionSecret:secret,lanDemo:false,secureCookies:false,clientDistPath:'/nonexistent'};
async function start(){server=createServer(createApplication(config,pool!).app);await new Promise<void>(r=>server!.listen(0,'127.0.0.1',r));const a=server.address();assert(a&&typeof a!=='string');base=`http://127.0.0.1:${a.port}`;}
async function stop(){if(server){server.closeAllConnections();await new Promise<void>((r,j)=>server!.close(e=>e?j(e):r()));server=undefined;}}
async function call(path:string,method='GET',body?:unknown,cookie?:string,token?:string){const headers:Record<string,string>={Origin:base};if(body!==undefined)headers['Content-Type']='application/json';if(cookie)headers.Cookie=cookie;if(token)headers.Authorization='Bearer '+token;if(path.startsWith('/api/staff')&&method!=='GET')headers['X-SIGAP-Request']='staff';if(path==='/api/citizen/incidents'&&method==='POST')headers['Idempotency-Key']=randomBytes(32).toString('hex');const response=await fetch(base+path,{method,headers,...(body===undefined?{}:{body:JSON.stringify(body)})});return {status:response.status,data:await response.json(),cookie:response.headers.get('set-cookie')?.split(';')[0]};}
async function login(username:string){const r=await call('/api/staff/session','POST',{username,password});assert.equal(r.status,200);assert(r.cookie);return r.cookie;}
try{
 await admin.query(`CREATE DATABASE "${name}"`);created=true;url.pathname='/'+name;pool=new pg.Pool({connectionString:url.toString(),max:1,connectionTimeoutMillis:3000});await runMigrations(pool);await bootstrapFirstAdmin(pool,'outbox_admin','Synthetic admin',password);await start();const root=await login('outbox_admin');
 for(const [username,role]of [['outbox_auditor','auditor'],['outbox_dispatch','dispatcher'],['outbox_foreign','operator_admin']]){const r=await call('/api/staff/accounts','POST',{username,password,displayName:'Synthetic '+role,role,regionIds:['local-staging']},root);assert.equal(r.status,201);if(username==='outbox_foreign'){await pool.query("INSERT INTO regions(id,name) VALUES('outbox-other','Synthetic other')");await pool.query('DELETE FROM staff_account_regions WHERE staff_id=$1',[r.data.id]);await pool.query("INSERT INTO staff_account_regions(staff_id,region_id) VALUES($1,'outbox-other')",[r.data.id]);}}
 const auditor=await login('outbox_auditor');const dispatcher=await login('outbox_dispatch');const foreign=await login('outbox_foreign');
 const create=()=>call('/api/citizen/incidents','POST',{category:'security',categoryId:'security',configVersion:1,description:'Synthetic outbox private description',locationMode:'simulation',initialLocation:{lat:0.1,lng:0.2},fieldAnswers:{}},undefined,randomBytes(32).toString('hex'));
 assert.equal((await create()).status,201);const event=(await pool.query('SELECT id FROM outbox_events')).rows[0].id;
 let calls=0;let failed=createOutboxPublisher(pool,()=>{calls++;return false;});for(let i=0;i<8;i++){await pool.query('UPDATE outbox_events SET next_attempt_at=clock_timestamp() WHERE id=$1',[event]);assert.equal(await failed.publishPending(50),0);}await pool.query('UPDATE outbox_events SET next_attempt_at=clock_timestamp() WHERE id=$1',[event]);await failed.publishPending(50);assert.equal(calls,8,'dead-letter event must not be attempted a ninth time');checks.push('eight failures stop automatic retry');
 const row=(await pool.query('SELECT attempts,failed_attempts_total,dead_lettered_at,published_at FROM outbox_events WHERE id=$1',[event])).rows[0];assert.equal(row.attempts,8);assert.equal(row.failed_attempts_total,'8');assert(row.dead_lettered_at);assert.equal(row.published_at,null);
 await stop();await pool.end();pool=new pg.Pool({connectionString:url.toString(),max:1,connectionTimeoutMillis:3000});await start();failed=createOutboxPublisher(pool,()=>{calls++;return false;});await failed.publishPending(50);assert.equal(calls,8);checks.push('dead-letter state and cumulative failures survive app/pool recreation');
 const endpoint='/api/staff/realtime/outbox';assert.equal((await call(endpoint)).status,401);assert.equal((await call(endpoint,'GET',undefined,dispatcher)).status,403);const view=await call(endpoint,'GET',undefined,auditor);assert.equal(view.status,200);assert.equal(view.data.items.length,1);assert.equal(view.data.maxAttempts,8);const item=view.data.items[0];assert.equal(item.id,event);for(const key of ['payload','description','location','accessTokenDigest'])assert(!(key in item));assert(!JSON.stringify(view.data).includes('private description'));checks.push('authorized audit role reads metadata only; dispatcher and anonymous access denied');
 const foreignPage=await call(endpoint,'GET',undefined,foreign);assert.equal(foreignPage.status,200);assert.equal(foreignPage.data.items.length,0);assert.equal((await call(endpoint+'/'+event+'/retry','POST',{reason:'Synthetic review'},foreign)).status,404);checks.push('region boundary applies to list and retry');
 assert.equal((await call(endpoint+'/'+event+'/retry','POST',{reason:'Synthetic review'},auditor)).status,403);assert.equal((await call(endpoint+'/'+event+'/retry','POST',{reason:''},root)).status,400);assert.equal((await call(endpoint+'?limit=0','GET',undefined,root)).status,400);assert.equal((await call(endpoint+'?cursor=invalid','GET',undefined,root)).status,400);const badYear=Buffer.from(JSON.stringify({time:'0000-10-12T00:00:00.123456Z',id:event,state:'dead_letter'})).toString('base64url');assert.equal((await call(endpoint+'?cursor='+badYear,'GET',undefined,root)).status,400);checks.push('retry permission and bounded reason/query validation enforced');
 const competing=await Promise.all([call(endpoint+'/'+event+'/retry','POST',{reason:'Synthetic review'},root),call(endpoint+'/'+event+'/retry','POST',{reason:'Synthetic review'},root)]);assert.deepEqual(competing.map(r=>r.status).sort(),[200,409]);const requeued=(await pool.query('SELECT attempts,failed_attempts_total,dead_lettered_at FROM outbox_events WHERE id=$1',[event])).rows[0];assert.equal(requeued.attempts,0);assert.equal(requeued.failed_attempts_total,'8');assert.equal(requeued.dead_lettered_at,null);
 const audit=await pool.query("SELECT details FROM staff_admin_audit_events WHERE action='outbox:retry'");assert.equal(audit.rowCount,1);assert.equal(audit.rows[0].details.eventId,event);assert.equal(audit.rows[0].details.reason,'Synthetic review');checks.push('concurrent manual retries yield one requeue and one conflict; actor audit atomic');
 const viaHttp=await call('/api/staff/audit/staff?limit=100','GET',undefined,auditor);assert.equal(viaHttp.status,200);const visibleAudit=viaHttp.data.find((r:any)=>r.action==='outbox:retry');assert(visibleAudit,'retry audit must be accessible through authenticated HTTP projection');assert.equal(visibleAudit.details.eventId,event);assert.equal(visibleAudit.details.reason,'Synthetic review');assert.equal(visibleAudit.details.totalFailures,'8');const foreignAudit=await call('/api/staff/audit/staff?limit=100','GET',undefined,foreign);assert(!foreignAudit.data.some((r:any)=>r.action==='outbox:retry'));checks.push('retry review is visible through scoped HTTP audit with allowlisted metadata');
 
 const pending=await call(endpoint+'?state=pending','GET',undefined,root);assert.equal(pending.data.items.length,1);assert.equal((await call(endpoint,'GET',undefined,root)).data.items.length,0);const success=createOutboxPublisher(pool,()=>true);assert.equal(await success.publishPending(50),1);assert.equal((await call(endpoint+'?state=pending','GET',undefined,root)).data.items.length,0);checks.push('requeued event can publish; published event leaves both review queues');
 for(let i=0;i<3;i++)assert.equal((await create()).status,201);await pool.query('UPDATE outbox_events SET attempts=7 WHERE published_at IS NULL');assert.equal(await failed.publishPending(50),0);await pool.query("WITH numbered AS (SELECT id,row_number() OVER(ORDER BY id) AS n FROM outbox_events WHERE published_at IS NULL) UPDATE outbox_events o SET occurred_at='2026-10-12T00:00:00.123456Z'::timestamptz + ((numbered.n-1)::integer * interval '1 microsecond') FROM numbered WHERE o.id=numbered.id");let cursor:string|null=null;const seen=new Set<string>();do{const page=await call(endpoint+'?limit=1'+(cursor?'&cursor='+encodeURIComponent(cursor):''),'GET',undefined,root);assert.equal(page.status,200);assert.equal(page.data.items.length,1);assert(!seen.has(page.data.items[0].id));seen.add(page.data.items[0].id);cursor=page.data.nextCursor;}while(cursor);assert.equal(seen.size,3);checks.push('metadata keyset pagination retains microsecond precision and has no duplicates');
 const target=[...seen][0];await pool.query("CREATE FUNCTION reject_retry_audit() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.action='outbox:retry' THEN RAISE EXCEPTION 'synthetic retry audit failure'; END IF; RETURN NEW; END $$");await pool.query('CREATE TRIGGER reject_retry_audit BEFORE INSERT ON staff_admin_audit_events FOR EACH ROW EXECUTE FUNCTION reject_retry_audit()');const rejected=await call(endpoint+'/'+target+'/retry','POST',{reason:'Synthetic review'},root);assert.equal(rejected.status,500);assert.equal(rejected.data.error.code,'internal_error');const unchanged=(await pool.query('SELECT attempts,dead_lettered_at FROM outbox_events WHERE id=$1',[target])).rows[0];assert.equal(unchanged.attempts,8);assert(unchanged.dead_lettered_at);await pool.query('DROP TRIGGER reject_retry_audit ON staff_admin_audit_events');await pool.query('DROP FUNCTION reject_retry_audit()');checks.push('audit fault rolls back requeue and emits sanitized error');
 console.log(JSON.stringify({status:'passed',scope:'synthetic PostgreSQL + actual HTTP/operator review; publisher success callback is a fixture, not socket receipt',checks},null,2));
}finally{await stop();if(pool)await pool.end();if(created){await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);}await admin.end();}
