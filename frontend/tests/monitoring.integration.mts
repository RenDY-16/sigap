import assert from 'node:assert/strict';
import { createServer } from 'node:http';
import { randomBytes } from 'node:crypto';
import pg from 'pg';
import { createApplication } from '../src/server/app.ts';
import { runMigrations } from '../src/server/db/migrate.ts';
import { bootstrapFirstAdmin } from '../src/server/identity/staff-repository.ts';
const url=new URL(process.env.SIGAP_VERIFY_DATABASE_URL??'postgresql://sigap_dev:sigap_local_synthetic_only@127.0.0.1:54329/sigap_staging');
const admin=new pg.Pool({connectionString:url.toString()});const name=`sigap_monitor_${Date.now()}_${randomBytes(4).toString('hex')}`;let created=false;let pool:pg.Pool|undefined;let server:ReturnType<typeof createServer>|undefined;let base='';
const secret=randomBytes(32).toString('hex');const password=randomBytes(24).toString('hex');const checks:string[]=[];
const config={databaseUrl:'unused',databasePoolMax:1,host:'127.0.0.1',port:0,sessionSecret:secret,lanDemo:false,secureCookies:false,clientDistPath:'/nonexistent'};
async function start(){server=createServer(createApplication(config,pool!).app);await new Promise<void>(r=>server!.listen(0,'127.0.0.1',r));const a=server.address();assert(a&&typeof a!=='string');base=`http://127.0.0.1:${a.port}`;}
async function stop(){if(server){server.closeAllConnections();await new Promise<void>((r,j)=>server!.close(e=>e?j(e):r()));server=undefined;}}
async function call(path:string,method='GET',body?:unknown,cookie?:string,token?:string){const headers:Record<string,string>={Origin:base};if(body!==undefined)headers['Content-Type']='application/json';if(cookie)headers.Cookie=cookie;if(token)headers.Authorization='Bearer '+token;if(path.startsWith('/api/staff')&&method!=='GET')headers['X-SIGAP-Request']='staff';if(path==='/api/citizen/incidents'&&method==='POST')headers['Idempotency-Key']=randomBytes(32).toString('hex');const r=await fetch(base+path,{method,headers,...(body===undefined?{}:{body:JSON.stringify(body)})});return {status:r.status,data:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0],cache:r.headers.get('Cache-Control')};}
async function login(username:string){const r=await call('/api/staff/session','POST',{username,password});assert.equal(r.status,200);assert(r.cookie);return r.cookie;}
const endpoint='/api/staff/monitoring';
try{
 await admin.query(`CREATE DATABASE "${name}"`);created=true;url.pathname='/'+name;pool=new pg.Pool({connectionString:url.toString(),max:1,connectionTimeoutMillis:3000});await runMigrations(pool);await bootstrapFirstAdmin(pool,'monitor_admin','Synthetic monitoring admin',password);await start();const root=await login('monitor_admin');
 // Removing the route returns 404 instead of the scoped empty aggregate.
 const empty=await call(endpoint,'GET',undefined,root);assert.equal(empty.status,200,'monitoring endpoint should return a scoped aggregate');assert.equal(empty.cache,'no-store');assert.equal(empty.data.incidents.active,'0');assert.equal(empty.data.realtime.pending,'0');assert.deepEqual(empty.data.signals,[]);assert(Number.isFinite(Date.parse(empty.data.sampledAt)));checks.push('empty authorized scope returns explicit zero counts, sample time and no-store');
 assert.equal((await call(endpoint)).status,401);assert.equal((await call(endpoint,'GET',undefined,undefined,randomBytes(32).toString('hex'))).status,401);checks.push('anonymous and citizen bearer access denied');
 const staff:Record<string,{cookie:string,id:string}>={};for(const [username,role] of [['monitor_dispatch','dispatcher'],['monitor_supervisor','supervisor'],['monitor_auditor','auditor'],['monitor_foreign','operator_admin']]){const r=await call('/api/staff/accounts','POST',{username,password,displayName:'Synthetic '+role,role,regionIds:['local-staging']},root);assert.equal(r.status,201);if(username==='monitor_foreign'){await pool.query("INSERT INTO regions(id,name) VALUES('monitor-other','Synthetic other')");await pool.query('DELETE FROM staff_account_regions WHERE staff_id=$1',[r.data.id]);await pool.query("INSERT INTO staff_account_regions(staff_id,region_id) VALUES($1,'monitor-other')",[r.data.id]);}staff[username]={cookie:await login(username),id:r.data.id};}
 const reports=[];for(let i=0;i<3;i++){const r=await call('/api/citizen/incidents','POST',{category:'security',categoryId:'security',configVersion:1,description:'Private synthetic report contents',locationMode:'simulation',initialLocation:{lat:0.1,lng:0.2},fieldAnswers:{}},undefined,randomBytes(32).toString('hex'));assert.equal(r.status,201);reports.push(r.data.id);}
 // SQL fixtures deliberately create queue ages/states; not proof of workflow transitions.
 await pool.query("UPDATE incidents SET created_at=clock_timestamp()-interval '20 minutes',updated_at=clock_timestamp()-interval '20 minutes' WHERE id=$1",[reports[0]]);
 await pool.query('UPDATE incidents SET owner_staff_id=$1 WHERE id=$2',[staff.monitor_dispatch.id,reports[1]]);
 await pool.query("UPDATE incidents SET status='resolved' WHERE id=$1",[reports[2]]);
 await pool.query("UPDATE outbox_events SET next_attempt_at=clock_timestamp()-interval '5 minutes' WHERE incident_id=$1",[reports[0]]);
 await pool.query("UPDATE outbox_events SET attempts=8,failed_attempts_total=10,dead_lettered_at=clock_timestamp() WHERE incident_id=$1",[reports[1]]);
 await pool.query('UPDATE outbox_events SET published_at=clock_timestamp(),failed_attempts_total=2 WHERE incident_id=$1',[reports[2]]);
 const view=await call(endpoint,'GET',undefined,root);assert.equal(view.status,200);assert.equal(view.data.incidents.active,'2');assert.equal(view.data.incidents.unowned,'1');assert.equal(view.data.incidents.overdue,'1');assert(view.data.incidents.oldestActiveSeconds>=1200&&view.data.incidents.oldestActiveSeconds<1300);assert.equal(view.data.incidents.byStatus.received,'2');assert.equal(view.data.incidents.byStatus.resolved,'1');checks.push('queue counts exclude terminal incidents and count scoped ownership, age and status');
 assert.equal(view.data.realtime.pending,'1');assert.equal(view.data.realtime.due,'1');assert.equal(view.data.realtime.deadLetter,'1');assert.equal(view.data.realtime.publishedLast15Minutes,'1');assert.equal(view.data.realtime.totalFailures,'12');assert.deepEqual(view.data.signals.map((s:any)=>s.code).sort(),['queue_overdue','realtime_dead_letter','realtime_due_delayed']);checks.push('outbox pending, due, dead-letter and recent server publish acceptance are distinct');
 await pool.query("UPDATE outbox_events SET published_at=NULL,next_attempt_at=clock_timestamp()+interval '1 hour',failed_attempts_total=9007199254740993 WHERE incident_id=$1",[reports[2]]);const future=await call(endpoint,'GET',undefined,root);assert.equal(future.data.realtime.pending,'2');assert.equal(future.data.realtime.due,'1');assert.equal(future.data.realtime.publishedLast15Minutes,'0');assert.equal(future.data.realtime.totalFailures,'9007199254741003');await pool.query('UPDATE outbox_events SET published_at=clock_timestamp(),failed_attempts_total=2 WHERE incident_id=$1',[reports[2]]);checks.push('future backoff stays pending without becoming due; large cumulative failures remain exact decimal strings');
 for(const username of ['monitor_dispatch','monitor_supervisor','monitor_auditor'])assert.equal((await call(endpoint,'GET',undefined,staff[username].cookie)).status,200);const foreign=await call(endpoint,'GET',undefined,staff.monitor_foreign.cookie);assert.equal(foreign.status,200);assert.equal(foreign.data.incidents.active,'0');assert.equal(foreign.data.incidents.overdue,'0');assert.equal(foreign.data.realtime.deadLetter,'0');assert.equal(foreign.data.realtime.totalFailures,'0');checks.push('all staff read roles supported; foreign-region aggregates remain isolated');
 const serialized=JSON.stringify(view.data);for(const privateValue of [...reports,'Private synthetic','latitude','longitude','accessTokenDigest','bucket_key',staff.monitor_dispatch.id])assert(!serialized.includes(privateValue));assert(!serialized.includes(password));checks.push('aggregate projection contains no report IDs, token, coordinates, descriptions or staff ownership identity');
 await stop();await pool.end();pool=new pg.Pool({connectionString:url.toString(),max:1,connectionTimeoutMillis:3000});await start();assert.equal((await call(endpoint,'GET',undefined,root)).data.realtime.deadLetter,'1');checks.push('snapshot derives from persisted state after app/pool recreation with pool size one');
 await pool.query('UPDATE staff_accounts SET active=false WHERE id=$1',[staff.monitor_dispatch.id]);assert.equal((await call(endpoint,'GET',undefined,staff.monitor_dispatch.cookie)).status,401);checks.push('disabled staff cannot use an existing monitoring session');
 await pool.query('ALTER TABLE staff_accounts RENAME TO staff_accounts_unavailable');const principalFailure=await call(endpoint,'GET',undefined,root);assert.equal(principalFailure.status,503,'principal storage outage must not be classified as an invalid session');assert.equal(principalFailure.data.error.code,'staff_authentication_unavailable');await pool.query('ALTER TABLE staff_accounts_unavailable RENAME TO staff_accounts');checks.push('principal lookup failure returns sanitized unavailable rather than expiring a valid user session');
 await pool.query('ALTER TABLE staff_sessions RENAME TO staff_sessions_unavailable');const sessionFailure=await call(endpoint,'GET',undefined,root);assert.equal(sessionFailure.status,503);assert.equal(sessionFailure.data.error.code,'staff_authentication_unavailable');await pool.query('ALTER TABLE staff_sessions_unavailable RENAME TO staff_sessions');checks.push('session restoration storage failure returns unavailable and succeeds again after recovery');assert.equal((await call(endpoint,'GET',undefined,root)).status,200);
 await pool.query('ALTER TABLE outbox_events RENAME TO outbox_events_unavailable');const failure=await call(endpoint,'GET',undefined,root);assert.equal(failure.status,503);assert.equal(failure.data.error.code,'monitoring_unavailable');assert(!JSON.stringify(failure.data).includes('outbox_events'));checks.push('query failure reports unavailable without fake zero/healthy values or SQL details');
 console.log(JSON.stringify({status:'passed',scope:'synthetic PostgreSQL and HTTP aggregate API; age/state SQL fixtures, no browser, on-call or production verification',checks},null,2));
}finally{await stop();if(pool)await pool.end();if(created){await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);}await admin.end();}
