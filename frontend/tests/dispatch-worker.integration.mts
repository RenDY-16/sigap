import assert from 'node:assert/strict';
import {randomBytes,randomUUID} from 'node:crypto';
import pg from 'pg';
import {runMigrations} from '../src/server/db/migrate.ts';
import {bootstrapFirstAdmin} from '../src/server/identity/staff-repository.ts';
import {LocalMockAdapter} from '../src/server/dispatch/local-mock-adapter.ts';
const url=new URL(process.env.SIGAP_VERIFY_DATABASE_URL??'postgresql://sigap_dev:sigap_local_synthetic_only@127.0.0.1:54329/sigap_staging');
const admin=new pg.Pool({connectionString:url.toString()});const name=`sigap_dispatch_worker_${Date.now()}_${randomBytes(4).toString('hex')}`;
let created=false;let pool:pg.Pool|undefined;const checks:string[]=[];
try{
 await admin.query(`CREATE DATABASE "${name}"`);created=true;url.pathname='/'+name;pool=new pg.Pool({connectionString:url.toString(),max:4,connectionTimeoutMillis:3000});await runMigrations(pool);
 await bootstrapFirstAdmin(pool,'worker_fixture_admin','Synthetic fixture',randomBytes(24).toString('hex'));
 const actor=(await pool.query('SELECT id FROM staff_accounts LIMIT 1')).rows[0].id;
 async function fixture(scenario:string){const incident=randomUUID(),id=randomUUID();await pool!.query(`INSERT INTO incidents(id,access_token_digest,idempotency_digest,payload_digest,category,description,status,location_mode,category_id,config_version,create_payload_version) VALUES($1,$2,$3,$4,'security','Synthetic worker fixture','triaged','gps','security',1,2)`,[incident,randomBytes(32).toString('hex'),randomBytes(32).toString('hex'),randomBytes(32).toString('hex')]);await pool!.query(`INSERT INTO dispatch_intents(id,incident_id,region_id,created_by_staff_id,idempotency_digest,payload_digest,correlation_id,scenario) VALUES($1,$2,'local-staging',$3,$4,$5,$6,$7)`,[id,incident,actor,randomBytes(32).toString('hex'),randomBytes(32).toString('hex'),randomUUID(),scenario]);return {id,incident};}
 const {claimDueDispatchIntent,completeDispatchAttempt,recoverExpiredDispatchLeases,processDispatchBatch,createDispatchCoordinator}=await import('../src/server/dispatch/dispatch-coordinator.ts');
 const adapter=new LocalMockAdapter();
 const accepted=await fixture('accepted');
 const competing=await Promise.all([claimDueDispatchIntent(pool,'worker-a'),claimDueDispatchIntent(pool,'worker-b')]);
 assert.equal(competing.filter(Boolean).length,1);const lease=competing.find(Boolean)!;
 assert.equal(lease.intentId,accepted.id);assert.equal(lease.attemptNumber,1);
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[accepted.id])).rows[0].status,'sending');
 assert.equal(await completeDispatchAttempt(pool,{...lease,leaseToken:randomUUID()},await adapter.send(lease)),false);
 assert.equal(await completeDispatchAttempt(pool,lease,await adapter.send(lease)),true);
 assert.equal(await completeDispatchAttempt(pool,lease,await adapter.send(lease)),false);
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[accepted.id])).rows[0].status,'accepted');
 assert.equal((await pool.query('SELECT count(*)::int AS n FROM dispatch_acknowledgements WHERE intent_id=$1',[accepted.id])).rows[0].n,1);
 checks.push('concurrent workers claim once; fenced completion accepts only the active lease and records one acknowledgement');
 const rejected=await fixture('rejected'),unknown=await fixture('unknown'),transient=await fixture('transient');
 assert.equal(await processDispatchBatch(pool,adapter,'scenario-worker'),3);
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[rejected.id])).rows[0].status,'manual_review');
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[unknown.id])).rows[0].status,'unknown');
 let r=(await pool.query('SELECT status,attempt_count,extract(epoch FROM next_attempt_at-updated_at)::float AS delay FROM dispatch_intents WHERE id=$1',[transient.id])).rows[0];assert.equal(r.status,'retry_wait');assert.equal(r.attempt_count,1);assert.equal(r.delay,1);
 assert.equal(await processDispatchBatch(pool,adapter,'scenario-worker'),0);
 await pool.query('UPDATE dispatch_intents SET next_attempt_at=clock_timestamp() WHERE id=$1',[transient.id]);assert.equal(await processDispatchBatch(pool,adapter,'scenario-worker'),1);
 r=(await pool.query('SELECT status,attempt_count,extract(epoch FROM next_attempt_at-updated_at)::float AS delay FROM dispatch_intents WHERE id=$1',[transient.id])).rows[0];assert.equal(r.attempt_count,2);assert.equal(r.delay,2);
 await pool.query('UPDATE dispatch_intents SET next_attempt_at=clock_timestamp() WHERE id=$1',[transient.id]);assert.equal(await processDispatchBatch(pool,adapter,'scenario-worker'),1);
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[transient.id])).rows[0].status,'dead_letter');assert.equal(await processDispatchBatch(pool,adapter,'scenario-worker'),0);
 checks.push('accepted/rejected/unknown stay distinct; only confirmed transient failures retry at 1/2 seconds and stop after three attempts');
 const expired=await fixture('accepted'),oldLease=await claimDueDispatchIntent(pool,'crashed-worker');assert(oldLease);
 await pool.query("UPDATE dispatch_intents SET lease_expires_at=clock_timestamp()-interval '1 second' WHERE id=$1",[expired.id]);
 assert.equal(await completeDispatchAttempt(pool,oldLease,await adapter.send(oldLease)),false);
 await pool.end();pool=new pg.Pool({connectionString:url.toString(),max:4,connectionTimeoutMillis:3000});
 assert.equal(await recoverExpiredDispatchLeases(pool),1);assert.equal(await completeDispatchAttempt(pool,oldLease,await adapter.send(oldLease)),false);
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[expired.id])).rows[0].status,'unknown');assert.equal(await processDispatchBatch(pool,adapter,'restart-worker'),0);
 checks.push('restart recovery turns expired sending into unknown without another send; late completion cannot overwrite recovery');
 const withdrawn=await fixture('accepted'),terminal=await fixture('accepted');await pool.query('UPDATE incidents SET withdrawal_requested_at=clock_timestamp() WHERE id=$1',[withdrawn.incident]);await pool.query("UPDATE incidents SET status='resolved' WHERE id=$1",[terminal.incident]);
 let sends=0;const counted={...adapter,key:'local-mock' as const,version:1 as const,send:async(input:any)=>{sends++;return adapter.send(input);}};
 await processDispatchBatch(pool,counted,'eligibility-worker');assert.equal(sends,0);
 for(const f of [withdrawn,terminal])assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[f.id])).rows[0].status,'cancelled');
 const thrown=await fixture('accepted');await processDispatchBatch(pool,{key:'local-mock',version:1,send:async()=>{throw new Error('Sensitive adapter content must not be persisted');}},'exception-worker');
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[thrown.id])).rows[0].status,'unknown');
 assert(!(await pool.query("SELECT 1 FROM dispatch_attempts WHERE diagnostic_code LIKE '%Sensitive%'")).rowCount);
 assert.equal((await pool.query('SELECT status FROM incidents WHERE id=$1',[accepted.incident])).rows[0].status,'triaged');
 checks.push('withdrawal/terminal incidents cancel before send; adapter exceptions become sanitized unknown; dispatch never changes incident status');
 const rollback=await fixture('accepted'),rollbackLease=await claimDueDispatchIntent(pool,'rollback-worker');assert(rollbackLease);
 await pool.query(`CREATE FUNCTION fail_dispatch_completion_audit() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN IF NEW.event='dispatch:attempt:completed' THEN RAISE EXCEPTION 'synthetic'; END IF; RETURN NEW; END $$`);await pool.query('CREATE TRIGGER fail_dispatch_completion_audit BEFORE INSERT ON audit_events FOR EACH ROW EXECUTE FUNCTION fail_dispatch_completion_audit()');
 await assert.rejects(completeDispatchAttempt(pool,rollbackLease,await adapter.send(rollbackLease)));
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[rollback.id])).rows[0].status,'sending');assert.equal((await pool.query('SELECT count(*)::int AS n FROM dispatch_acknowledgements WHERE intent_id=$1',[rollback.id])).rows[0].n,0);
 await pool.query('DROP TRIGGER fail_dispatch_completion_audit ON audit_events');assert.equal(await completeDispatchAttempt(pool,rollbackLease,await adapter.send(rollbackLease)),true);
 checks.push('completion, attempt, acknowledgement and audit commit atomically or roll back together');
 for(let i=0;i<12;i++)await fixture('accepted');assert.equal(await processDispatchBatch(pool,adapter,'bounded-worker'),10);assert.equal(await processDispatchBatch(pool,adapter,'bounded-worker'),2);
 const final=await fixture('accepted');const loop=createDispatchCoordinator(pool,adapter,'loop-worker');loop.start();loop.start();await new Promise(resolve=>setTimeout(resolve,100));await loop.stop();assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[final.id])).rows[0].status,'accepted');
 checks.push('batches are bounded at ten; coordinator start is idempotent and stop drains its active batch');
 const draining=await fixture('accepted');let release!:(value:any)=>void;let started!:()=>void;
 const begun=new Promise<void>(resolve=>{started=resolve;}),pending=new Promise<any>(resolve=>{release=resolve;});
 const drainingLoop=createDispatchCoordinator(pool,{key:'local-mock',version:1,send:()=>{started();return pending;}},'draining-worker');
 drainingLoop.start();await begun;let drained=false;const stopping=drainingLoop.stop().then(()=>{drained=true;});
 await Promise.resolve();assert.equal(drained,false);release({result:'accepted',diagnosticCode:'mock_accepted',simulated:true});await stopping;
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[draining.id])).rows[0].status,'accepted');
 const timeout=await fixture('accepted');await processDispatchBatch(pool,{key:'local-mock',version:1,send:()=>new Promise(()=>{})},'timeout-worker');
 assert.equal((await pool.query('SELECT status FROM dispatch_intents WHERE id=$1',[timeout.id])).rows[0].status,'unknown');
 checks.push('stop waits for an in-flight attempt; a stalled adapter reaches bounded unknown rather than hanging or retrying');
 console.log(JSON.stringify({status:'passed',scope:'isolated real PostgreSQL worker/lease lifecycle; local mock only',checks},null,2));
}finally{if(pool)await pool.end();if(created)await admin.query(`DROP DATABASE "${name}" WITH (FORCE)`);await admin.end();}
