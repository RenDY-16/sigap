import assert from 'node:assert/strict';
import { createServer } from 'node:http';
import { randomBytes } from 'node:crypto';
import pg from 'pg';
import { createApplication } from '../src/server/app.ts';
import { runMigrations } from '../src/server/db/migrate.ts';
// Creates/drops only its own unique synthetic database.
const url=new URL(process.env.SIGAP_VERIFY_DATABASE_URL??'postgresql://sigap_dev:sigap_local_synthetic_only@127.0.0.1:54329/sigap_staging');
const admin=new pg.Pool({connectionString:url.toString()});const name=`sigap_intake_${Date.now()}_${randomBytes(4).toString('hex')}`;
const secret=randomBytes(32).toString('hex');const config={databaseUrl:'unused',databasePoolMax:12,host:'127.0.0.1',port:0,sessionSecret:secret,lanDemo:false,secureCookies:false,clientDistPath:'/nonexistent'};
let created=false;let pool:pg.Pool|undefined;let server:ReturnType<typeof createServer>|undefined;let base='';const checks:string[]=[];
const payload={category:'security',categoryId:'security',configVersion:1,description:'Synthetic intake throttle verification',locationMode:'simulation',initialLocation:{lat:0.1,lng:0.2},fieldAnswers:{}};
const token=randomBytes(32).toString('hex');const key=randomBytes(32).toString('hex');
async function start(){server=createServer(createApplication(config,pool!).app);await new Promise<void>(r=>server!.listen(0,'127.0.0.1',r));const a=server.address();assert(a&&typeof a!=='string');base=`http://127.0.0.1:${a.port}`;}
async function stop(){if(server){server.closeAllConnections();await new Promise<void>((r,j)=>server!.close(e=>e?j(e):r()));server=undefined;}}
async function create(bearer=token,body=JSON.stringify(payload),extra:Record<string,string>={}){const response=await fetch(base+'/api/citizen/incidents',{method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+bearer,'Idempotency-Key':key,...extra},body});return {status:response.status,data:await response.json(),retryAfter:response.headers.get('Retry-After')};}
try{
 await admin.query(`CREATE DATABASE "${name}"`);created=true;url.pathname='/'+name;pool=new pg.Pool({connectionString:url.toString(),max:12,connectionTimeoutMillis:3000});await runMigrations(pool);await start();
 // Missing HTTP protection makes the eleventh attempt return 201 instead of 429.
 const ids=new Set();for(let i=0;i<10;i++){const r=await create();assert.equal(r.status,201);ids.add(r.data.id);}assert.equal(ids.size,1);
 const blocked=await create();assert.equal(blocked.status,429,'eleventh attempt for one citizen token must be throttled');assert.equal(blocked.data.error.code,'intake_throttled');assert(Number(blocked.retryAfter)>=1&&Number(blocked.retryAfter)<=60);assert.equal((await pool.query('SELECT count(*) FROM incidents')).rows[0].count,'1');checks.push('normal idempotent retries return the same report; eleventh attempt is bounded with Retry-After');
 const stored=(await pool.query('SELECT bucket_key,attempts,expires_at FROM citizen_intake_throttle')).rows;assert.equal(stored.length,2);assert(stored.every(r=>/^[0-9a-f]{64}$/.test(r.bucket_key)));assert(!JSON.stringify(stored).includes(token));assert(!JSON.stringify(stored).includes('127.0.0.1'));checks.push('persistent buckets contain only pseudonymous HMAC keys, counts and expiry');
 const expires=stored.map(r=>[r.bucket_key,r.expires_at.toISOString()]).sort();await stop();await pool.end();pool=new pg.Pool({connectionString:url.toString(),max:12});await start();assert.equal((await create()).status,429);const after=(await pool.query('SELECT bucket_key,expires_at FROM citizen_intake_throttle')).rows;assert.deepEqual(after.map(r=>[r.bucket_key,r.expires_at.toISOString()]).sort(),expires);checks.push('application and pool recreation preserve counters without extending the blocked window');
 assert.equal((await create(Buffer.from(token,'hex').toString('base64url'))).status,429);assert.equal((await create(token.toUpperCase())).status,429);checks.push('hex, uppercase hex and base64url encodings share one credential budget');
 const read=await fetch(base+'/api/citizen/incidents',{headers:{Authorization:'Bearer '+token}});assert.equal(read.status,200);await read.text();const withdraw=await fetch(base+'/api/citizen/incidents/withdrawal',{method:'POST',headers:{Authorization:'Bearer '+token}});assert.equal(withdraw.status,200);await withdraw.text();checks.push('create throttling leaves existing report access and withdrawal available');
 await pool.query("UPDATE citizen_intake_throttle SET expires_at=clock_timestamp()-interval '1 second'");assert.equal((await create()).status,201);checks.push('expired windows reset and idempotent retry returns the original report');
 await pool.query('TRUNCATE citizen_intake_throttle');const race=await Promise.all(Array.from({length:20},()=>create()));assert.equal(race.filter(r=>r.status===201).length,10);assert.equal(race.filter(r=>r.status===429).length,10);checks.push('twenty concurrent HTTP reservations admit exactly ten attempts for one token');
 await pool.query('TRUNCATE citizen_intake_throttle');for(let i=0;i<120;i++)assert.equal((await create('invalid','{',{'X-Forwarded-For':`198.51.100.${i}`,Forwarded:`for=198.51.100.${i}`})).status,400);assert.equal((await create('invalid','{',{'X-Forwarded-For':'203.0.113.99'})).status,429);assert.equal((await create(randomBytes(32).toString('hex'))).status,429);assert.equal((await pool.query('SELECT count(*) FROM citizen_intake_throttle')).rows[0].count,'1');checks.push('malformed requests and spoofed forwarding headers cannot bypass connection-source cap');
 await pool.query('TRUNCATE citizen_intake_throttle');const {createIntakeThrottle}=await import('../src/server/security/intake-throttle.ts');const reserve=createIntakeThrottle(pool,secret);for(let i=0;i<10;i++)assert.equal((await reserve(`synthetic-source-${i}`,token)).allowed,true);assert.equal((await createIntakeThrottle(pool,secret)('synthetic-source-last',token)).allowed,false);checks.push('credential budget applies across sources and independent throttle instances');
 await pool.query('TRUNCATE citizen_intake_throttle');const sources=await Promise.all(Array.from({length:130},()=>reserve('shared-synthetic-network',randomBytes(32).toString('hex'))));assert.equal(sources.filter(r=>r.allowed).length,120);assert.equal(sources.filter(r=>!r.allowed).length,10);assert.equal((await pool.query('SELECT count(*) FROM citizen_intake_throttle')).rows[0].count,'121');checks.push('shared-source concurrency caps rotated valid credentials and bounds bucket allocation');
 await pool.query('ALTER TABLE citizen_intake_throttle RENAME TO citizen_intake_throttle_unavailable');const unavailable=await create();assert.equal(unavailable.status,503);assert.equal(unavailable.data.error.code,'intake_protection_unavailable');assert.equal((await pool.query('SELECT count(*) FROM incidents')).rows[0].count,'1');checks.push('unavailable protection storage fails closed without creating an incident');
 console.log(JSON.stringify({status:'passed',scope:'synthetic PostgreSQL and real HTTP create; staging limits, not a complete abuse or production assessment',checks},null,2));
}finally{await stop();if(pool)await pool.end();if(created){await admin.query('SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname=$1 AND pid<>pg_backend_pid()',[name]);await admin.query(`DROP DATABASE "${name}"`);}await admin.end();}
